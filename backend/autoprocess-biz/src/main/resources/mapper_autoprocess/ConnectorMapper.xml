<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autoprocess.mapper.ConnectorMapper">

    <!-- Connector table result mapping. -->
    <resultMap id="BaseResultMap" type="com.autoprocess.entity.Connector">
        <id column="id" jdbcType="VARCHAR" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="type" jdbcType="VARCHAR" property="type"/>
        <result column="base_url" jdbcType="VARCHAR" property="baseUrl"/>
        <result column="auth_type" jdbcType="VARCHAR" property="authType"/>
        <result column="enabled" jdbcType="BIT" property="enabled"/>
        <result column="created_at" jdbcType="TIMESTAMP" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, type, base_url, auth_type, enabled, created_at
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from connector
        order by created_at desc
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from connector
        where id = #{id}
    </select>
</mapper>
