<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autoprocess.mapper.NodeExecutionLogMapper">

    <!-- Node execution log result mapping. -->
    <resultMap id="BaseResultMap" type="com.autoprocess.entity.NodeExecutionLog">
        <id column="id" jdbcType="VARCHAR" property="id"/>
        <result column="instance_id" jdbcType="VARCHAR" property="instanceId"/>
        <result column="node_id" jdbcType="VARCHAR" property="nodeId"/>
        <result column="node_name" jdbcType="VARCHAR" property="nodeName"/>
        <result column="status" jdbcType="VARCHAR" property="status"/>
        <result column="input_json" jdbcType="LONGVARCHAR" property="inputJson"/>
        <result column="output_json" jdbcType="LONGVARCHAR" property="outputJson"/>
        <result column="error_message" jdbcType="VARCHAR" property="errorMessage"/>
        <result column="started_at" jdbcType="TIMESTAMP" property="startedAt"/>
        <result column="finished_at" jdbcType="TIMESTAMP" property="finishedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, instance_id, node_id, node_name, status, input_json, output_json, error_message, started_at, finished_at
    </sql>

    <select id="selectByInstanceId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from node_execution_log
        where instance_id = #{instanceId}
        order by started_at asc
    </select>

    <insert id="insert" parameterType="com.autoprocess.entity.NodeExecutionLog">
        insert into node_execution_log
        (id, instance_id, node_id, node_name, status, input_json, output_json, error_message, started_at, finished_at)
        values
        (#{id}, #{instanceId}, #{nodeId}, #{nodeName}, #{status}, #{inputJson}, #{outputJson}, #{errorMessage}, #{startedAt}, #{finishedAt})
    </insert>
</mapper>
